# --- Supabase ---
# Get these from https://app.supabase.com -> your project -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Optional: only needed for server-side admin tasks (e.g. running migrations from a script)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- CRM read-only API (/api/v1) ---
# Long random secret (≥24 chars). Comma-separate several keys to rotate.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRM_API_KEY=
